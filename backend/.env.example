NODE_ENV=development
PORT=3000

# Matches the root docker-compose sqlserver service (host port 14330 maps to
# the container's 1433, avoiding a clash with any locally-installed SQL
# Server/Express instance on the default port).
DB_HOST=localhost
DB_PORT=14330
DB_USERNAME=sa
DB_PASSWORD=Str0ng!LocalDevPass
DB_NAME=OrderManagementSystem

# Local dev only — trusts the Docker container's self-signed TLS cert.
# Never set to true against RDS/production.
DB_TRUST_SERVER_CERTIFICATE=true
